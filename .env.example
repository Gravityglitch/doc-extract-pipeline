# Copy to .env and fill in. Never commit .env. Every variable docpipe reads is listed here.

# ---- Claude -------------------------------------------------------------------
# Required for real extraction. Not needed for `docpipe run --mock` or the review API.
ANTHROPIC_API_KEY=sk-ant-...
# Model id used for classification + extraction.
DOCPIPE_MODEL=claude-sonnet-5-5
# Per-request timeout in seconds and number of retries on 429/5xx/network errors.
DOCPIPE_LLM_TIMEOUT_SECONDS=120
DOCPIPE_LLM_MAX_RETRIES=3
# Set to true to use the fixture extractor (no API calls) - same as `--mock`.
DOCPIPE_MOCK=false

# ---- Storage ------------------------------------------------------------------
# SQLAlchemy URL. SQLite for local/dev (default: sqlite:///<repo>/out/docpipe.db),
# Postgres in production, e.g. postgresql+psycopg://docpipe:docpipe@db:5432/docpipe
DATABASE_URL=sqlite:///out/docpipe.db
# SQLite schemas are created automatically. Postgres is migrated with `alembic upgrade head`;
# set this to true only to let the app create tables itself (not recommended in prod).
DOCPIPE_AUTO_CREATE_SCHEMA=

# ---- Paths --------------------------------------------------------------------
# Folder watched for .pdf/.eml/.txt; IMAP polling writes into this folder too.
DOCPIPE_INBOX_DIR=inbox
# Folder holding ledger.csv and purchase_orders.csv.
DOCPIPE_DATA_DIR=data
# Where extracted.jsonl, exceptions.csv, briefing.md and mail_archive/ are written.
DOCPIPE_OUT_DIR=out
# Fixture file used by --mock.
DOCPIPE_FIXTURES_FILE=tests/fixtures/extractions.json
# Override the reporting date (YYYY-MM-DD); defaults to today (or 2026-10-08 under --mock).
DOCPIPE_AS_OF=

# ---- Ingestion ----------------------------------------------------------------
# folder = process files already in DOCPIPE_INBOX_DIR; imap = poll a mailbox first.
DOCPIPE_INGEST_MODE=folder
# IMAP server details (required when DOCPIPE_INGEST_MODE=imap). Use an app password.
DOCPIPE_IMAP_HOST=imap.gmail.com
DOCPIPE_IMAP_PORT=993
DOCPIPE_IMAP_USER=ap@example.com
DOCPIPE_IMAP_PASSWORD=
# Mailbox/label to read from and the folder processed mail is moved to (created if missing).
DOCPIPE_IMAP_MAILBOX=AP/Incoming
DOCPIPE_IMAP_DONE_MAILBOX=AP/Processed
# false only for a local test server without TLS.
DOCPIPE_IMAP_SSL=true

# ---- Review API ---------------------------------------------------------------
# Shared secret clients must send in the X-API-Key header. Required by `docpipe api`.
DOCPIPE_API_KEY=change-me
DOCPIPE_API_HOST=0.0.0.0
DOCPIPE_API_PORT=8000

# ---- Exceptions sink ----------------------------------------------------------
# csv = out/exceptions.csv (default); sheets = Google Sheets (needs `uv sync --extra sheets`).
DOCPIPE_SINK=csv
# Spreadsheet id from the sheet URL and the worksheet tab to overwrite.
DOCPIPE_SHEETS_SPREADSHEET_ID=
DOCPIPE_SHEETS_WORKSHEET=exceptions
# Path to a Google service-account JSON with edit access to the spreadsheet.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Scheduler / logging ------------------------------------------------------
# Seconds between runs for `docpipe loop` (the docker-compose runner).
DOCPIPE_RUN_INTERVAL_SECONDS=300
# DEBUG, INFO, WARNING, ERROR
DOCPIPE_LOG_LEVEL=INFO
# json for production log shipping; console for humans.
DOCPIPE_LOG_FORMAT=json
